# Bi-ISL Project Environment Configurations

# Paths
BIISL_DATA_DIR=./data
BIISL_ARTIFACTS_DIR=./artifacts
BIISL_CONFIGS_DIR=./configs

# Experiment Settings
BIISL_RANDOM_SEED=42
BIISL_LOG_LEVEL=INFO

# Target Execution Device
BIISL_DEVICE=cuda  # options: cuda, cpu, mps

# Mobile Deployment Settings
BIISL_ONNX_MODEL_PATH=./artifacts/models/biisl_mobile.onnx
