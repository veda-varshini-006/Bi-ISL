# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Pytest / Coverage / Tool Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Virtual Environments
.venv/
env/
venv/
ENV/

# Large Raw Datasets (keep split manifests in data/splits)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
*.tmp
